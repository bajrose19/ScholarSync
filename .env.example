# Public Supabase project URL and anon key.
# These are safe to expose in the browser. Never put the service role key here.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional. Set this only for local email-confirmation testing.
# Leave it unset in production so signup uses the live site origin.
# NEXT_PUBLIC_DEV_SUPABASE_REDIRECT_URL=http://localhost:3000/auth/callback
